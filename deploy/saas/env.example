# SaaS deployment environment (copy to `/srv/reviews-saas/.env`, chmod 600)
REVIEWS_DB_DRIVER=postgres
REVIEWS_DB_DSN=postgres://reviews:CHANGE_ME@127.0.0.1:5432/reviews?sslmode=disable
REVIEWS_COMPAT_SINGLE_TENANT=false
REVIEWS_CREDENTIALS_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
REVIEWS_ROBOKASSA_LOGIN=
REVIEWS_ROBOKASSA_PASSWORD1=
REVIEWS_ROBOKASSA_PASSWORD2=
REVIEWS_ROBOKASSA_TEST=1
REVIEWS_SMTP_HOST=smtp.yandex.ru:465
REVIEWS_SMTP_USER=
REVIEWS_SMTP_PASS=
REVIEWS_SMTP_FROM=
REVIEWS_SYNC_INTERVAL=1h
REVIEWS_PUBLIC_DOMAIN=reviews.example.com
REVIEWS_SHOP_ORIGIN=https://example.com
